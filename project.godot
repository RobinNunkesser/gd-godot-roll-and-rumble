; Engine configuration file.
; Roll & Rumble 3D (Sumo / Bumper Arena) in Godot 4
; Phase 1: Scaffolding & Core Loop

config_version=5

[application]

config/name="Roll & Rumble 3D"
config/description="3D Physics Bumper Sumo Party Game in Godot 4. Roll, boost and knock opponents off the floating arena!"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

p1_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":65)] ; Key A
}
p1_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":68)] ; Key D
}
p1_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":87)] ; Key W
}
p1_down={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":83)] ; Key S
}
p1_boost={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":32)] ; Key Space
}

p2_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194319)] ; Left Arrow
}
p2_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194321)] ; Right Arrow
}
p2_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194320)] ; Up Arrow
}
p2_down={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194322)] ; Down Arrow
}
p2_boost={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194309)] ; Enter
}

pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":80)] ; P
}
restart={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":82)] ; R
}
